    {
      "parameters": {
        "jsCode": "return $input.all().map((row) => {\n  const playlist_data = row.json;\n  const track = playlist_data.item\n\n  return {\n    json: {\n      // -- For the playlist_tracks table --\n      playlist_id:  playlist_data.playlist_id,\n      local_position: playlist_data.local_position,\n      added_at: playlist_data.added_at,\n      \n      // -- For the tracks table --\n      spotify_id:  track.id|| track.uri || 'local_file_' + playlist_data.local_position,\n      track_name: track.name || 'Unknown Track',\n      artists: track.artists ? track.artists.map(a => a.name).join(', ') : 'Unknown Artist',\n      album_name: track.album ? track.album.name : 'Unknown Album',\n      album_release_date: track.album ? track.album.release_date : null,\n      album_track_number: track.track_number || 1\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3856,
        -1232
      ],
      "id": "410c6787-7614-4955-ae79-8e249b5d6bd1",
      "name": "Code in JavaScript7"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((row, index) => {\n  // 1. Isolate the 'items' object (this leaves behind the parent wrapper)\n  const items = row.json.items;\n\n  // 2. Inject the new data directly into the isolated object\n  items.playlist_id = row.json.href.split('/')[5];\n  items.local_position = index + 1;\n\n  // 3. Return ONLY the enriched items object, perfectly wrapped for n8n\n  return { \n    json: items \n  };\n});"
      },
      "type": "n8n-nodes-base.code",
